# Environment variables for Phase 0

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-key-here

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_phase0

# CORS local/dev/smoke
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://127.0.0.1:3005,http://localhost:3010,http://127.0.0.1:3010,http://localhost:3015,http://127.0.0.1:3015
CORS_ALLOW_CREDENTIALS=true

# Session cookies
# Use false only for local HTTP development/smoke. Keep true in staging/production HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# LLM model for answers
LLM_MODEL=gpt-4o-mini

# Chunking parameters
CHUNK_SIZE=1200
CHUNK_OVERLAP=240

# Retrieval defaults
DEFAULT_TOP_K=5
DEFAULT_THRESHOLD=0.70
